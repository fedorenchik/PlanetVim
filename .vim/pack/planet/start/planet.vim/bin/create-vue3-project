#!/usr/bin/env python3
"""Compatibility entry point for the portable PlanetVim generator."""
from pathlib import Path
import runpy
import sys

helper = Path(__file__).resolve().parent / 'generate-project.py'
sys.argv = [str(helper)] + ['framework', 'vue3'] + sys.argv[1:]
runpy.run_path(str(helper), run_name='__main__')
